# Database
DATABASE_URL=postgresql://podtranslate:password@localhost:5432/podtranslate
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=podtranslate_analytics

# Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

# Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_AUDIO=podtranslate-audio
S3_BUCKET_TRANSCRIPTS=podtranslate-transcripts
CDN_URL=https://cdn.podtranslate.com

# AI Services
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
DEEPL_API_KEY=your-deepl-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Transcription
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda  # or cpu
PYANNOTE_AUTH_TOKEN=your-huggingface-token

# Platform APIs
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
APPLE_KEY_ID=your-apple-key-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_PRIVATE_KEY_PATH=/path/to/apple/private/key.p8
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google/credentials.json
YOUTUBE_API_KEY=your-youtube-api-key

# Monetization
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret

# Analytics
SEGMENT_WRITE_KEY=your-segment-key
MIXPANEL_TOKEN=your-mixpanel-token
GOOGLE_ANALYTICS_ID=UA-your-ga-id

# Application
NODE_ENV=development
PORT=3000
API_GATEWAY_PORT=3000
AUDIO_PROCESSING_PORT=3001
DISTRIBUTION_PORT=3002
ANALYTICS_PORT=3003
AI_TOOLS_PORT=3004

# Security
JWT_SECRET=your-jwt-secret-key-change-this
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Monitoring
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# CDN
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Features
ENABLE_TTS=true
ENABLE_AUTO_DISTRIBUTION=true
ENABLE_SEO_OPTIMIZATION=true
MAX_CONCURRENT_JOBS=5
