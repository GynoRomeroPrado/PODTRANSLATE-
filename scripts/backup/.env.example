# Backup Configuration

# Deployment type: kubernetes or docker
DEPLOYMENT_TYPE=kubernetes

# PostgreSQL
DB_HOST=postgres.podtranslate.svc.cluster.local
DB_USER=podtranslate
DB_NAME=podtranslate
PGPASSWORD=changeme

# ClickHouse
CLICKHOUSE_HOST=clickhouse.podtranslate.svc.cluster.local
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme

# S3 Buckets
S3_AUDIO_BUCKET=podtranslate-prod-audio
S3_TRANSCRIPTS_BUCKET=podtranslate-prod-transcripts
S3_BACKUP_BUCKET=podtranslate-prod-backups

# Backup Settings
BACKUP_DIR=/var/backups/podtranslate
RETENTION_DAYS=30
BACKUP_S3_DATA=false  # Set to true to backup S3 files locally

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
